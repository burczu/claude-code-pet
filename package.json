{
  "name": "claude-code-pet",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "smoke": "agent-device test smoke-tests/",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@shopify/restyle": "^2.4.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~54.0.10",
    "big.js": "^7.0.1",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-haptics": "~15.0.8",
    "expo-localization": "^55.0.13",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "groq-sdk": "^1.1.2",
    "i18next": "^26.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lucide-react-native": "^1.7.0",
    "react": "19.1.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|big.js)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 65,
        "branches": 55,
        "functions": 70,
        "lines": 72
      }
    }
  },
  "type": "module",
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@shopify/eslint-plugin": "^50.0.0",
    "@types/big.js": "^6.2.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "agent-device": "^0.12.9",
    "eslint": "^9.39.4",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react-native-dotenv": "^3.4.11",
    "typescript": "^6.0.2"
  }
}
